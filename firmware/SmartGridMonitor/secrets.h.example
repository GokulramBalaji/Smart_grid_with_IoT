// Copy this file to "secrets.h" in the same folder and fill in your real
// values. secrets.h is gitignored so you never commit real credentials.
#pragma once

// ---- Wi-Fi ----
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---- This device's identity ----
// Must be unique across your whole SmartGrid Monitor account and match
// ^[A-Za-z0-9_-]+$ (letters, numbers, hyphens, underscores only).
// One real ESP32 = one deviceIdentifier = one utility node's Device row.
#define DEVICE_IDENTIFIER "ESP32-SMARTGRID-004"

// ---- Backend ----
// Base URL of your SmartGrid Monitor deployment, NO trailing slash.
//   - Local dev server on your LAN:  "http://192.168.1.50:3000"
//   - Production behind HTTPS:        "https://your-app.example.com"
#define BACKEND_BASE_URL "http://192.168.1.50:3000"

// Shared bootstrap secret — copy the exact value of DEVICE_API_SECRET from
// the server's .env file. Every un-provisioned ESP32 uses this SAME value;
// it is only ever used to announce itself and to pick up its own real,
// per-device API key once an operator claims it in the web UI (see
// README.md's "Auto-provisioning" section). It is never used to send
// sensor readings.
#define DEVICE_API_SECRET "dev-only-device-secret-change-me"
