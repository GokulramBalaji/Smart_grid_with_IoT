# PostgreSQL connection string used by Prisma
# Example (local): postgresql://postgres:postgres@localhost:5432/smartgrid_monitor?schema=public
DATABASE_URL=

# Auth.js (NextAuth v5) secret — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public URL of the deployed app (used for absolute links, callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared bootstrap secret baked into ESP32 firmware, used ONLY by the
# unclaimed-device announce endpoint (POST /api/devices/announce) before a
# device has been claimed into a utility and issued its own per-device API
# key. Not the same as a per-device API key. Generate with `openssl rand -hex 32`.
DEVICE_API_SECRET=

# Seed script credentials for the demo account created by `npm run db:seed`
# Quote any value containing "#" — dotenv treats an unquoted "#" as a comment.
SEED_DEMO_EMAIL=demo@smartgrid.io
SEED_DEMO_PASSWORD="SmartGrid#2026"
